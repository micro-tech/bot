        {
          "id": 236.3,
          "title": "Rework spend.rs on metered values",
          "status": "done",
          "dependencies": [
            236.1,
            236.2
          ]
        },
        {
          "id": 236.4,
          "title": "Expose per-day/per-backend usage",
          "status": "done",
