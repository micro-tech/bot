    {
      "id": 158,
      "title": "Tool Supervisor v2: Validation + Retry + Error Classification",
      "description": "Upgrade the Tool Supervisor to validate tool arguments, classify tool errors, retry failed calls when appropriate, and provide structured feedback to the planner. This improves reliability and prevents the agent from stalling or hallucinating when tools fail.",
      "priority": "high",
      "status": "done",
      "dependencies": [
        156
      ],
      "details": "All subtasks including 158.5 (tests + the never_loop fix in execute()) are complete. The dead loop was removed and logic simplified with explanatory comment. Integration in runtime_loop.rs works. Task marked fully done.",
      "subtasks": [
        {
          "id": "158.1",
          "status": "done",
          "title": "Add ToolError enum with classification",
          "description": "Define ToolError { InvalidArgs, ExecutionError, NotFound, RateLimit, Timeout, Unknown }. Include original error message and optional context."
        },
        {
          "id": "158.2",
          "status": "done",
          "title": "Add ToolResult enum",
          "description": "Define ToolResult { Success(Value), RetryableError(ToolError), FatalError(ToolError) }. This becomes the canonical output of all tool calls."
        },
        {
          "id": "158.3",
          "status": "done",
          "title": "Implement ToolSupervisorV2",
          "description": "Wrap all tool calls with argument validation, error classification, and retry logic. Retry up to N times for RetryableError. Return FatalError for non-retryable cases."
        },
        {
          "id": "158.4",
          "status": "done",
          "title": "Integrate ToolSupervisorV2 into runtime loop",
          "description": "Modify runtime_loop.rs so ToolCall steps use ToolSupervisorV2. Push normalized ToolResult into AgentState and RuntimeTrace."
        },
        {
          "id": "158.5",
          "status": "done",
          "title": "Add tests for ToolSupervisorV2",
          "description": "Unit tests for error classification, retry behavior, and integration with RuntimeLoop."
        }
      ]
    },
