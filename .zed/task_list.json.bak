          "title": "Add runtime trace flag / log level control"
        },
        {
          "id": "154.4",
          "status": "done",
          "title": "Test end-to-end via CLI and bus event"
        }
      ],
      "testStrategy": "Run agent.run from CLI with trace logs visible. Send AgentRun bus message and verify AgentFinished event is emitted.",
