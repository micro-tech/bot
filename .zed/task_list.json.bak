      "dependencies": [
        154
      ],
      "description": "Enable the Unified Agent Runtime Loop to make structured decisions by integrating the existing planning/ module through a thin adapter layer with proper PlannerOutput enum and reflection parsing.",
      "details": "This is the next-level planner integration. It introduces PlannerOutput as the canonical decision type and a ReflectionPlannerAdapter that parses reflection text into structured actions (ToolCall, LLMCall, FinalAnswer). Must not modify planning/planner.rs or planning/reflection.rs.",
      "id": 155,
      "priority": "high",
      "status": "done",
      "subtasks": [
        {
          "id": "155.1",
          "status": "done",
          "title": "Add Planner trait with decide(&AgentState) -> PlannerOutput"
        },
        {
          "id": "155.2",
          "status": "done",
          "title": "Add PlannerOutput enum (LLMCall, ToolCall, FinalAnswer, Error)"
        },
        {
          "id": "155.3",
          "status": "done",
          "title": "Implement ReflectionPlannerAdapter with reflection parsing logic"
        },
        {
          "id": "155.4",
          "status": "done",
          "title": "Integrate PlannerOutput handling into RuntimeLoop"
        },
        {
          "id": "155.5",
          "status": "done",
          "title": "Add unit tests for PlannerOutput + adapter parsing and integration test"
        }
      ],
      "testStrategy": "Unit tests for trait and parsing, integration test running full RuntimeLoop with ReflectionPlannerAdapter, verify no changes to existing planning/ module.",
      "title": "Planner v2: Structured PlannerOutput + ReflectionPlannerAdapter"
    },
