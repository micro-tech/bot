      "id": 154,
      "priority": "high",
      "status": "done",
      "subtasks": [
        {
          "id": "154.1",
          "status": "done",
          "title": "Add detailed per-step logging in RuntimeLoop (planner decision, step type, tool result, memory)"
        },
        {
