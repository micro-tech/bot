%% Layer 7: Self-Improve, Chat-Command, Support Watch, Voice, OKF
flowchart TB
    CPU --> SelfImp["Self-Improve<br/>(self_improve/mod.rs)"]
    SelfImp --> Eval["Evaluator<br/>(self_improve/evaluator.rs)"]
    SelfImp --> Budgets["Budgets<br/>(self_improve/budgets.rs)"]
    SelfImp --> Worker["Worker<br/>(self_improve/worker.rs)"]
    Eval -->|applies diff in worktree + runs tests| Git["Git<br/>(self_improve/git.rs)"]
    SelfImp -->|proposals| PR["PR Draft<br/>(self_improve/pr.rs)"]

    Bus --> ChatCmd["Chat-Command<br/>(chat_command/mod.rs)"]
    ChatCmd --> Envelope["Envelope<br/>(chat_command/envelope.rs)"]
    ChatCmd --> MCPH["MCP Handler<br/>(chat_command/mcp_handler.rs)"]
    ChatCmd --> Executor["Executor<br/>(chat_command/executor.rs)"]

    Bus --> Support["Support Watch<br/>(support_watch/mod.rs)"]
    Support --> Drafter["Drafter<br/>(support_watch/drafter.rs)"]
    Support --> Drafts["Drafts<br/>(support_watch/drafts.rs)"]

    CPU --> Voice["Voice<br/>(voice/mod.rs)"]
    Voice --> VoiceClient["Voice Client<br/>(voice/client.rs)"]

    CPU --> OKFMod["OKF<br/>(okf/mod.rs)"]
    OKFMod --> Fetcher["Fetcher<br/>(okf/fetcher.rs)"]
    OKFMod --> Validator["Validator<br/>(okf/validator.rs)"]
    OKFMod --> Registry["Registry<br/>(okf/registry.rs)"]

    style SelfImp fill:#ff9,stroke:#f66,stroke-width:2px
    style ChatCmd fill:#9ff,stroke:#66f
    style Support fill:#fc9,stroke:#c83
