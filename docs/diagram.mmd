    Bus --> MCP["MCP Handler<br/>(mcp/mcp_handler.rs)"]
    Bus --> MCPClient["MCP Client<br/>(mcp_client/)"]
    Bus --> ACP["ACP Server<br/>(acp/server.rs)"]

    style Web fill:#9f9,stroke:#3a3
    style Scheduler fill:#f99,stroke:#933

